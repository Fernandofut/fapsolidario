# ==========================================================
# FAP Solidário — variáveis de ambiente da API (NÃO versionar)
# Copie este arquivo para `.env` e ajuste os valores.
# ==========================================================

# Porta em que o servidor escuta (server.js)
PORT=3000

# Origem do frontend aceita pelo CORS quando servido por outro servidor
# (ex.: Live Server na porta 5500). Comente para aceitar qualquer origem em dev.
# CORS_ORIGIN=http://localhost:5500

# Segredo que assina o cookie de sessão (HMAC-SHA256). Use um valor longo e
# aleatório — gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Ligar apenas quando a API estiver atrás de HTTPS (produção)
# COOKIE_SECURE=true

# ==========================================================
# E-mail — notificação de novas solicitações de doação
# ==========================================================
# Sem SMTP_HOST/SMTP_USER/SMTP_PASS o serviço entra em MODO SIMULAÇÃO:
# o e-mail é montado e registrado no console, sem envio real.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@fapsolidario.org
# SMTP_PASS=troque-esta-senha
# SMTP_FROM=FAP Solidário <no-reply@fapsolidario.org>

# Opcional em desenvolvimento/testes: grava cada e-mail simulado em JSONL.
# EMAIL_SIMULADO_FILE=/tmp/emails-fapsolidario.jsonl

